# Copy to .env.local and fill in. Values come from the Supabase dashboard:
# Project Settings -> API Keys

# The project's REST endpoint. Public.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (Supabase's replacement for the old `anon` key).
# SAFE in the browser by design — it identifies the project, it does not grant
# access. Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (replaces `service_role`). BYPASSES Row Level Security
# entirely — it can read and write every row in every table.
# NEVER prefix it with NEXT_PUBLIC_. NEVER import it into a Client Component.
# Server-side only, and not needed until an admin/import task requires it.
# SUPABASE_SECRET_KEY=

# Direct Postgres connection, used only by `pnpm db:seed`.
# Supabase dashboard -> Connect -> Session pooler. Contains your DB password.
# DATABASE_URL=
